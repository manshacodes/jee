{
  "name": "exam-notice-radar",
  "version": "1.0.0",
  "private": true,
  "description": "Live notification aggregator for CBSE and NTA (JEE, NEET UG, Class 10 & 12 boards)",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "fetch:once": "node server/cli-fetch.js",
    "test": "node --test \"test/**/*.test.js\"",
    "build:static": "node scripts/build-static.js",
    "ci:scrape": "node scripts/ci-run.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "web-push": "^3.6.7"
  }
}
