# Copy to .env (or just export these) -- every one is optional.

# Port the web server listens on.
PORT=3000

# Password gate (HTTP Basic). Leave APP_PASSWORD unset for localhost; SET IT
# for any deployment that is reachable from the internet, or anyone with the
# URL can read your feed and change your fetch interval.
APP_USER=admin
# APP_PASSWORD=pick-something-long

# Where the scraped feed, settings, push subscriptions and VAPID keys live.
DATA_DIR=./data

# Web Push identity. Leave these unset and a key pair is generated once into
# data/vapid.json. Set them explicitly if you deploy to more than one instance,
# or to keep subscriptions valid across a redeploy that wipes DATA_DIR.
# Generate with:  npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Comma-separated hosts whose TLS chain should not be verified.
#
# Some government portals serve an incomplete certificate chain (they omit the
# intermediate certificate, which browsers paper over by fetching it via the
# certificate's AIA extension, but Node does not). nta.ac.in has done this in
# the past. Only add a host here if a fetch fails with
# "unable to get local issuer certificate", and understand that it disables
# chain verification for that host.
# INSECURE_TLS_HOSTS=nta.ac.in
